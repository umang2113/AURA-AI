<Window x:Class="AuraCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA Windows Companion" 
        Height="450" Width="360"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Glassmorphism Styles -->
        <Style x:Key="GlassPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#CC0F172A"/>
            <Setter Property="BorderBrush" Value="#3300F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Outer Glowing Container -->
        <Border Style="{StaticResource GlassPanelStyle}" Margin="10">
            <Border.Effect>
                <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            
            <Grid Padding="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Ellipse Width="12" Height="12" Fill="#00F0FF" Margin="0,0,8,0"/>
                        <TextBlock Text="AURA COMPANION" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" LetterSpacing="1"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" Content="✕" Width="24" Height="24" 
                            Background="Transparent" BorderBrush="Transparent" Foreground="#94A3B8"
                            Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>

                <!-- Chat Logs / Transcript Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                    <StackPanel x:Name="ChatHistoryStack" Margin="0,5">
                        <!-- Welcome Message -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <TextBlock Text="AURA initialized. Press Win+Space globally to speak." 
                                       Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Orb Controls -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ManualInputBox" Height="40" Background="#1E293B" Foreground="White"
                             BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10,8" Margin="0,0,10,0"
                             GotFocus="ManualInputBox_GotFocus" KeyDown="ManualInputBox_KeyDown"/>
                    
                    <Button Grid.Column="1" Width="40" Height="40" Background="#00F0FF" BorderBrush="Transparent"
                            Cursor="Hand" Click="SendButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="➔" Foreground="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
